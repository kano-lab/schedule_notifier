{
	"compilerOptions": {
		"lib": ["ESNext", "DOM"],
		"types": ["web", "bun-types"],
		"target": "ESNext",
		"module": "NodeNext",
		"moduleDetection": "force",
		"allowJs": true,

		// モジュール解決の設定を修正
		"moduleResolution": "NodeNext",
		"resolveJsonModule": true,
		"esModuleInterop": true,

		"noEmit": false,
		"strict": true,
		"skipLibCheck": true,
		"noFallthroughCasesInSwitch": true,

		// パス解決の設定
		"baseUrl": ".",
		"rootDir": "src",
		"outDir": "dist",
		"paths": {
			"@/*": ["./src/*"]
		}
	},
	"include": ["src/**/*"],
	"exclude": ["node_modules"]
}
